# Set this in the Vercel project (Production) and redeploy.
# No trailing slash. The browser calls this host for every /api request.
# Example: https://schootype-api.onrender.com
VITE_API_URL=

# Optional. Leave empty to keep passport photos in Supabase as data URLs.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional. Public Schooltype profile URLs for the marketing footer.
VITE_SOCIAL_X=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
