# Backend environment (copy to backend/.env and fill in values)

# Public URLs (magic-link emails use FRONTEND_URL)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# JWT signing secret (32+ characters). Required in production.
JWT_SECRET=

# Google sign-in / sign-up (Web client ID from Google Cloud Console)
# Also add authorized JS origins: http://localhost:3000 and your production site
GOOGLE_CLIENT_ID=

# Email (required for signup verification + broadcasts)
# EMAIL_USER = the Gmail/SMTP account that SENDS mail (not the signup recipient)
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_SERVICE=gmail
# Optional alias; never used as verification recipient
BROADCAST_EMAIL=

# Twilio SMS (platform account)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
SMS_DEFAULT_COUNTRY_CODE=233
SMS_DRY_RUN=false
SMS_SEND_CONCURRENCY=5

# Daily Vercel cron for subscription due reminders (Authorization: Bearer <secret>)
CRON_SECRET=


# Required for new school signup — the account is created only after Paystack succeeds
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_CURRENCY=GHS
# Optional: percent of each parent fee payment kept by Schooltype. 0 = the school receives the settlement.
PAYSTACK_PLATFORM_PERCENT=0

