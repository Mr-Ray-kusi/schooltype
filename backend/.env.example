# Backend environment (copy to backend/.env and fill in values)
# Production: put these on the Render service, not on Vercel.
# Vercel only needs VITE_API_URL (see frontend/.env.example).

# Public URLs
# FRONTEND_URL is the Vercel site. Email and Paystack return links use it.
FRONTEND_URL=http://localhost:3000
# BACKEND_URL is this API. On Render it is the onrender.com URL.
# Point the Paystack webhook at BACKEND_URL/api/webhooks/paystack
BACKEND_URL=http://localhost:5000

# Supabase project URL (required). Use https://<project-ref>.supabase.co
# Do not put the Postgres connection string here. The API uses the Supabase HTTPS API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase JWT secret so each school request is limited to that school.
SUPABASE_JWT_SECRET=

# Wallets, SMS units, and login limits are stored in Supabase.
WALLET_STORE=supabase
SMS_STORE=supabase
AUTH_STORE=supabase

# Comma-separated browser origins allowed to call this API with cookies.
CORS_ORIGINS=http://localhost:3000,https://schootype.vercel.app

# JWT signing secret (32+ characters). Required in production.
JWT_SECRET=

# Google sign-in / sign-up (Web client ID from Google Cloud Console)
# Also add authorized JS origins: http://localhost:3000 and your production site
GOOGLE_CLIENT_ID=

# Email (required for signup verification + broadcasts)
# EMAIL_USER = the Gmail/SMTP account that SENDS mail (not the signup recipient)
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_SERVICE=gmail
# Optional alias; never used as verification recipient
BROADCAST_EMAIL=

# Twilio SMS (platform account)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
SMS_DEFAULT_COUNTRY_CODE=233
SMS_DRY_RUN=false
SMS_SEND_CONCURRENCY=5

# Locks POST/GET /api/cron/subscription-reminders. The Render process also runs this job daily.
CRON_SECRET=


# Required for new school signup — the account is created only after Paystack succeeds
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_CURRENCY=GHS
# Optional: percent of each parent fee payment kept by Schooltype. 0 = the school receives the settlement.
PAYSTACK_PLATFORM_PERCENT=0

